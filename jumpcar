local uis = game:GetService("UserInputService")
local rs = game:GetService("RunService")
local isholdingt = false
local jumpImpulse = 100  -- La force du saut

uis.InputBegan:Connect(function(a)
    if a.KeyCode == Enum.KeyCode.T then
        isholdingt = true
    end
end)

uis.InputEnded:Connect(function(a)
    if a.KeyCode == Enum.KeyCode.T then
        isholdingt = false
    end
end)

rs.Heartbeat:Connect(function(deltatime)
    local player = game:GetService("Players").LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local seat = humanoid.SeatPart

    if seat and isholdingt then
        -- Appliquer une impulsion verticale (saut) à la partie du siège
        local currentVelocity = seat.AssemblyLinearVelocity

        -- Ajouter une impulsion uniquement sur l'axe Y pour simuler un saut
        seat.AssemblyLinearVelocity = Vector3.new(currentVelocity.X, jumpImpulse, currentVelocity.Z)
    end
end)
